node {
  width: 42px;
  height: 42px;
  content: data(name);
  font-size: 10px;
  font-weight: 500;
  color: #334155;
  text-wrap: ellipsis;
  text-max-width: 120px;
  text-valign: bottom;
  text-halign: center;
  text-margin-y: 7px;
  text-background-color: #f8fafc;
  text-background-opacity: 0.86;
  text-background-padding: 2px;
  background-color: #94a3b8;
  border-width: 1px;
  border-color: #e2e8f0;
}

node[weight=10] {
  width: 30px;
  height: 30px;
  font-size: 8px;
  background-color: #94a3b8;
}

node[weight=20] {
  width: 36px;
  height: 36px;
  font-size: 9px;
  background-color: #8b5cf6;
}

node[weight=30] {
  width: 42px;
  height: 42px;
  font-size: 9px;
  background-color: #f59e0b;
}

node[weight=40] {
  width: 58px;
  height: 58px;
  font-size: 11px;
  background-color: #16a34a;
}

node[weight=60] {
  width: 66px;
  height: 66px;
  font-size: 11px;
  background-color: #15803d;
}

node.hot {
  content: data(unionCount);
  text-valign: center;
  text-margin-y: 0;
  font-size: 11px;
  color: #ffffff;
  text-background-opacity: 0;
  background-color: mapData(unionCount, 0, 10, #cbd5e1, #ef4444);
}

node.snapshot {
  width: 56px;
  height: 56px;
  font-size: 10px;
  background-color: #16a34a;
  border-width: 2px;
  border-color: #bbf7d0;
}

node.snapshot[weight=60] {
  width: 66px;
  height: 66px;
  background-color: #15803d;
}

node.subSelected {
  z-index: 1200;
  background-color: #38bdf8;
  border-width: 4px;
  border-color: #0284c7;
  color: #075985;
  text-background-color: #e0f2fe;
  text-background-opacity: 0.95;
}

node.find {
  z-index: 900;
  border-width: 4px;
  border-color: #facc15;
  text-background-color: #fef08a;
  text-background-opacity: 1;
}

node.table {
  width: 30px;
  height: 30px;
  font-size: 8px;
  background-color: #60a5fa;
  shape: round-rectangle;
}

node.table.subSelected {
  content: data(name);
  font-size: 8px;
  color: #075985;
}

node.remote {
  background-color: #f1a9a0;
  width: 25px;
  height: 25px;
}

node.code_class {
  width: 34px;
  height: 34px;
  font-size: 8px;
  background-color: #64748b;
  color: #334155;
}

node.stack_code {
  width: 38px;
  height: 38px;
  font-size: 11px;
  font-weight: 600;
  color: #111827;
  text-max-width: 145px;
  text-wrap: ellipsis;
  text-background-color: #ffffff;
  text-background-opacity: 0.92;
  text-background-padding: 3px;
  border-width: 1.5px;
  border-color: #cbd5e1;
}

node.stack_code[weight=0] {
  width: 34px;
  height: 34px;
  background-color: #64748b;
}

node.stack_code[weight=10] {
  width: 34px;
  height: 34px;
  background-color: #5e5757;
}

node.stack_code[weight=20] {
  width: 42px;
  height: 42px;
  background-color: #9233ac;
}

node.stack_code[weight=30] {
  width: 50px;
  height: 50px;
  background-color: #b87a44;
}

node.stack_code[weight=40] {
  width: 58px;
  height: 58px;
  background-color: #16a34a;
}

node.entry_code {
  width: 66px;
  height: 66px;
  background-color: #16a34a;
  border-width: 4px;
  border-color: #bbf7d0;
  color: #064e3b;
  text-max-width: 190px;
}

node.notice {
  width: 76px;
  height: 76px;
  shape: round-rectangle;
  background-color: #fef3c7;
  border-color: #f59e0b;
  border-width: 2px;
  color: #92400e;
  font-size: 10px;
  text-wrap: wrap;
  text-max-width: 180px;
}

node.app {
  background-image: /images/1f4bb.png;
  background-fit: contain;
  background-clip: none;
  width: 56px;
  height: 56px;
  font-size: 10px;
}

node:selected {
  z-index: 999;
  background-color: #e11d48;
  border-width: 5px;
  border-color: #020617;
  color: #e11d48;
  text-background-color: #fff1f2;
  text-background-opacity: 0.95;
}

node.subSelected:selected,
node.subSelected.highlight {
  z-index: 1300;
  background-color: #38bdf8;
  border-width: 4px;
  border-color: #0284c7;
  color: #075985;
  text-background-color: #e0f2fe;
  text-background-opacity: 0.95;
}

node.highlight {
  content: data(name);
  color: #f1eaea;
  text-outline-width: 3px;
  text-outline-color: #df3c5a;
  background-color: #df3c5a;
  border-width: 8px;
}

edge {
  opacity: 0.48;
  width: 1.2px;
  font-size: 8px;
  color: #475569;
  line-color: #94a3b8;
  target-arrow-color: #94a3b8;
}

edge.highlight {
  opacity: 0.9;
  color: #df3c5a;
  line-color: #df3c5a;
  target-arrow-color: #df3c5a;
}

edge.snapshot-reference {
  content: data(name);
  curve-style: bezier;
  line-style: dashed;
  line-color: #22c55e;
  target-arrow-color: #22c55e;
  target-arrow-shape: triangle;
  width: 2.2px;
  opacity: 0.72;
  font-size: 8px;
  color: #15803d;
  text-background-color: #f0fdf4;
  text-background-opacity: 0.9;
  text-background-padding: 2px;
}

edge.snapshot-reference.hidden-reference {
  display: none;
}

edge.snapshot-reference.subSelected {
  z-index: 1200;
  line-style: solid;
  line-color: #0284c7;
  target-arrow-color: #0284c7;
  target-arrow-shape: triangle;
  width: 4px;
  opacity: 1;
  color: #075985;
  font-size: 9px;
  font-weight: 600;
  text-background-color: #dbeafe;
  text-background-opacity: 0.98;
  text-background-padding: 3px;
}

edge.snapshot-reference.subSelected[weight] {
  line-style: solid;
}

edge.app-relation {
  content: data(name);
  curve-style: unbundled-bezier;
  line-color: #21b8b0;
  target-arrow-color: #21b8b0;
  target-arrow-shape: triangle-backcurve;
  width: 2.5px;
  opacity: 0.82;
  font-size: 10px;
  font-weight: 600;
  color: #334155;
  text-background-color: #ffffff;
  text-background-opacity: 0.95;
  text-background-padding: 4px;
  text-border-color: #b7ebe7;
  text-border-opacity: 1;
  text-border-width: 1px;
  text-border-style: solid;
  text-rotation: autorotate;
  text-margin-y: -8px;
  text-wrap: wrap;
  text-max-width: 92px;
  min-zoomed-font-size: 7px;
}

edge.invoke {
  curve-style: unbundled-bezier;
  target-arrow-shape: triangle-backcurve;
}

edge.table {
  curve-style: unbundled-bezier;
  width: 2px;
  target-arrow-shape: triangle-backcurve;
  font-size: 10px;
}

edge.table.update {
  line-color: #cc6600;
  target-arrow-color: #cc6600;
  content: 改;
}

edge.table.insert {
  line-color: green;
  target-arrow-color: green;
  content: 增;
}

edge.table.delete {
  line-color: red;
  target-arrow-color: red;
  content: 删;
}
