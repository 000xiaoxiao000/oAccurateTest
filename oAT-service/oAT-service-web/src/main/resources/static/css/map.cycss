node {
    /*width: mapData(weight, 0, 100, 50, 50);*/
   /* height: mapData(weight, 0, 100, 50, 50);*/
    width: 50;
    height: 50;
    content:data(name);
    font-size: 30px;
    color: #3f3b3b; /*字颜色-灰黑色*/
    background-color: #8a8a8a;  /*节点颜色-灰色*/
}
node[weight=10] {
    content: data(name);
    width: 40;
    height: 40;
    font-size: 30px;
    color: #5e5757; /*灰色*/
    background-color: #5e5757;  /*灰色*/
}
node[weight=20] {
    content:data(name);
    width: 70;
    height: 70;
    font-size: 30px;
    color: #5e5757; /*灰色*/
    background-color: #9233ac;  /*暗紫色*/
}
node[weight=30] {
    content:data(name);
    width: 100;
    height: 100;
    font-size: 30px;
    color: #5e5757; /*灰色*/
    background-color: #b87a44;  /*黄褐色*/
}
node[weight=40] {
    content: data(name);
    width: 150;
    height: 150;
    font-size: 30px;
    color: #5e5757; /*灰色*/
    background-color: #3ad606; /*绿色*/
}

node.hot{
  content: data(unionCount);
  background-color: mapData(unionCount, 0, 10, #CCCCCC,#CC3333);
}

node.snapshot{
    background-color: green;
}

node.subSelected{
  background-color: #BBDEFB;
}

node.find{
  z-index: 10;
  text-background-color: yellow;
  text-background-opacity: 1;
}

node.table{
    width: 15;
    height: 15;
}
/*待重构*/
node.table.subSelected{
    content: data(name);
    font-size: 1.5px;
    color: #1976D2;
}
node.remote {
    background-color: #f1a9a0;
    width: 25;
    height: 25;
}

node.code_class{
    font-size: 30px;
    color: #8a8a8a;
}

node.app{
  background-image:/images/1f4bb.png;
  background-fit: contain;
  background-clip: none;
  width: 56;
  height: 56;
  font-size: 10px;
}
node:selected{
  z-index: 999;
  color: #0169D9;
  background-color: #0169D9;
}
node.highlight{
    content: data(name);
    color: #f1eaea;  /*灰白色*/
    text-outline-width: 5;
    text-outline-color: #df3c5a;
    background-color: #df3c5a;
    border-width: 12;
}

edge{
  opacity:0.6;/*透明度*/
  /*width: mapData(weight, 0, 100, 10, 10);*/
  width: 15px;
  font-size: 50px;
}
edge.highlight{
    color: #df3c5a;
    line-color: #df3c5a;
    target-arrow-color: #df3c5a;
}
edge.app-relation{
    content: data(name);
    curve-style: unbundled-bezier;
    line-color: #21b8b0;
    target-arrow-color: #21b8b0;
    target-arrow-shape: triangle-backcurve;
    width: 2px;
    font-size: 7px;
    color: #4b5563;
    text-background-color: #f6f8fb;
    text-background-opacity: 0.85;
}
/*调用*/
edge.invoke{
    curve-style: unbundled-bezier; /*贝塞尔曲线*/
    target-arrow-shape: triangle-backcurve; /*三角箭头*/
}
edge.table{
    curve-style: unbundled-bezier; /*贝塞尔曲线*/
    width: 5;
    target-arrow-shape: triangle-backcurve; /*三角箭头*/
    font-size: 50px;
}

edge.table.update {
    line-color: #cc6600;
    target-arrow-color: #cc6600;
    content: 改;
}
edge.table.insert {
    line-color: green;
    target-arrow-color: green;
    content: 增;
}
edge.table.delete {
    line-color: red;
    target-arrow-color: red;
    content: 删;
}
